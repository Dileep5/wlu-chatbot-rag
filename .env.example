# WLU Hybrid RAG Assistant — environment configuration template.
#
# Copy this file to `.env` in the project root and fill in your own
# value(s). `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env

# Required for any non-deterministic response: the hybrid-retrieval
# fallback (LLM synthesis over retrieved context), conversational small
# talk, and the LLM fallback layer of off-topic detection.
#
# Deterministic structured answers (a real course, program, faculty,
# department, or policy record) render without ever calling the OpenAI
# API, so the app will partially function without this key - but most
# open-ended questions will not.
#
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
